# Copie para .env.local e ajuste se precisar.

# Endereço da API em produção. Deixe vazio quando o site e a API forem servidos juntos (wwwroot).
VITE_API_URL=

# Para onde o servidor de desenvolvimento (npm run dev) repassa as chamadas /api.
VITE_PROXY_API=http://localhost:5080

# true = modo demonstração (dados fictícios no navegador, sem API nem banco). Prefira: npm run demo
VITE_DEMO=false
